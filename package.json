{
	"name": "@fundar/data-chart-telling",
	"version": "1.2.0",
	"description": "Declarative charts, maps and small multiples for Svelte, built on svelteplot.",
	"license": "MIT",
	"author": "Ezequiel Puerta",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/datos-Fundar/data-chart-telling.git"
	},
	"homepage": "https://github.com/datos-Fundar/data-chart-telling#readme",
	"bugs": {
		"url": "https://github.com/datos-Fundar/data-chart-telling/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.19"
	},
	"packageManager": "pnpm@11.25.0",
	"type": "module",
	"scripts": {
		"build": "svelte-package",
		"prepack": "svelte-package && publint",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"check:unused-types": "knip --include types",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --project=unit --project=browser",
		"test:coverage": "node scripts/coverage.mjs",
		"test:perf": "vitest run --project=perf --reporter=verbose",
		"test:stories": "vitest run --project=storybook",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"docs:images": "node scripts/docs-images.mjs",
		"docs:examples": "node scripts/sync-examples.mjs",
		"prepare": "husky"
	},
	"files": [
		"LICENSE",
		"CHANGELOG.md",
		"dist",
		"docs",
		"!docs/images",
		"examples",
		"!examples/geo",
		"!examples/datasets/amba-partidos.ts",
		"!examples/datasets/argentina-provinces.ts",
		"!examples/datasets/caba-comunas.ts",
		"!examples/datasets/napoleons-rivers.ts",
		"!examples/datasets/usa-country.ts",
		"!examples/datasets/world-countries.ts",
		"!examples/datasets/world-countries-topology.ts",
		"llms.txt",
		"llms-full.txt"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"@types/geojson": "^7946.0.16",
		"d3-array": "^3.2.4",
		"d3-geo": "^3.1.1",
		"d3-interpolate": "^3.0.1",
		"d3-scale-chromatic": "^3.1.0",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"svelteplot": "^0.14.0",
		"topojson-client": "^3.1.0"
	},
	"peerDependenciesMeta": {
		"topojson-client": {
			"optional": true
		}
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.4.1",
		"@storybook/addon-docs": "^10.4.1",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.4.1",
		"@storybook/svelte-vite": "^10.4.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-array": "^3.2.2",
		"@types/d3-geo": "^3.1.0",
		"@types/d3-interpolate": "^3.0.4",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/d3-selection": "^3.0.11",
		"@types/d3-zoom": "^3.0.8",
		"@types/node": "^22",
		"@vitest/browser": "^4.1.7",
		"@vitest/browser-playwright": "^4.1.7",
		"@vitest/coverage-v8": "4.1.7",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.4.1",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"knip": "^6.32.1",
		"playwright": "^1.64.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.3.18",
		"storybook": "^10.4.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelteplot": "^0.14.0",
		"topojson-client": "^3.1.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.1"
	},
	"keywords": [
		"svelte",
		"svelteplot",
		"charts",
		"data-visualization",
		"maps",
		"small-multiples"
	]
}
